# Stage 1: Build - Install mintlify CLI, run prebuild to generate content
FROM node:20-slim AS builder

# Install mintlify CLI globally
RUN npm install -g mintlify@4.2.414

# Copy docs source content
WORKDIR /docs-source
COPY docs/ .

# Run mintlify dev briefly to:
# 1. Download the pre-built Next.js client to ~/.mintlify/mint/
# 2. Run prebuild() to populate src/_props/ and public/ with processed content
# Then kill it - we only need the prebuild output, not the dev server
RUN mintlify dev --port 9999 & \
    MPID=$! && \
    for i in $(seq 1 60); do \
      if curl -s -o /dev/null http://localhost:9999/ 2>/dev/null; then break; fi; \
      sleep 2; \
    done && \
    kill $MPID 2>/dev/null; \
    wait $MPID 2>/dev/null || true

# Stage 2: Runtime - nginx serves static files, node serves dynamic routes
# nginx is needed because Next.js standalone server does not properly decode
# percent-encoded parentheses in static file paths (e.g. route groups like
# "(local)" become "%28local%29" in browser requests, causing 404s).
FROM node:20-slim

RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends nginx \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the pre-built Next.js standalone client
COPY --from=builder /root/.mintlify/mint/apps/client/ ./client/

# Copy required node_modules (next.js runtime dependencies)
COPY --from=builder /root/.mintlify/mint/node_modules/ ./node_modules/

# nginx config: serve _next/static directly, proxy rest to Next.js
COPY nginx-docs.conf /etc/nginx/sites-available/default

ENV NODE_PATH=/app/node_modules
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0

EXPOSE 3000

# Start nginx (background) then Next.js standalone server on port 3001
CMD nginx && PORT=3001 node /app/client/server.js
